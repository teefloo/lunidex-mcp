{
  "name": "lunidex-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for reading and writing supported Lunidex API data",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
